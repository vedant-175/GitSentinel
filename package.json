{
  "name": "ai-code-reviewer-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Code Review & PR Assistant - GitHub App & Real-time Repo Health Dashboard",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspaces",
    "build:packages": "npm run build --workspace=@ai-reviewer/shared && npm run build --workspace=@ai-reviewer/db",
    "build:shared": "npm run build --workspace=@ai-reviewer/shared",
    "build:db": "npm run build --workspace=@ai-reviewer/db",
    "lint": "eslint \"packages/shared/src/**/*.ts\" \"apps/worker/src/**/*.ts\" && npm run lint --workspace=apps/web",
    "typecheck": "npm run build:packages && npm run typecheck:workspaces",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --import tsx --test eval/eval.test.ts scripts/phase-g.test.ts",
    "test:webhook": "tsx scripts/test-webhook-e2e.ts",
    "test:load": "tsx scripts/load-test-queue.ts",
    "test:load:100": "tsx scripts/load-test-100.ts",
    "eval": "tsx eval/run-eval.ts",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:push": "npm run push --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:seed:demo": "tsx scripts/seed-demo-data.ts",
    "db:studio": "npm run studio --workspace=packages/db",
    "simulate:pr": "npm run simulate --workspace=apps/worker",
    "postinstall": "npm run db:generate",
    "health": "tsx scripts/full-system-check.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:env-tracked": "tsx scripts/verify-no-env.ts",
    "review:pre-push": "tsx scripts/pre-push-review.ts"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "postcss": "^8.5.3",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
