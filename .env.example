# ==========================================
# GitHub App Credentials
# ==========================================
# Found in GitHub App Settings -> General
GITHUB_APP_ID=123456
# Base64 encoded or multiline PEM private key generated in GitHub App Settings
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret-here"

# ==========================================
# Database & Cache (PostgreSQL & Redis)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_code_review?schema=public"
REDIS_URL="redis://localhost:6379"

# ==========================================
# NextAuth / Dashboard Auth
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-byte-secret"
# GitHub OAuth App credentials (can be GitHub App Client ID & Secret)
NEXTAUTH_GITHUB_CLIENT_ID="Iv1.xxxxxxxxxxxx"
NEXTAUTH_GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# LLM Configuration (Worker Service)
# ==========================================
# Provider: 'gemini' | 'openai' | 'mock' (mock works out of the box with 0 keys!)
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Concurrency of parallel PR review jobs in the BullMQ worker
WORKER_CONCURRENCY=5
