# ==========================================
# GitHub App Credentials
# ==========================================
# Found in GitHub App Settings -> General
GITHUB_APP_ID=123456
# Base64 encoded or multiline PEM private key generated in GitHub App Settings
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret-here"

# ==========================================
# Database & Cache (PostgreSQL & Redis)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_code_review?schema=public"
REDIS_URL="redis://localhost:6379"

# ==========================================
# NextAuth / Dashboard Auth
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-byte-secret"
# GitHub OAuth App credentials (can be GitHub App Client ID & Secret)
NEXTAUTH_GITHUB_CLIENT_ID="Iv1.xxxxxxxxxxxx"
NEXTAUTH_GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# LLM Configuration (Worker Service)
# ==========================================
# Provider: 'gemini' | 'openai' | 'anthropic' (MockProvider is permitted ONLY when NODE_ENV=test)
LLM_PROVIDER="gemini"

# Gemini: GEMINI_MODEL is required if LLM_PROVIDER="gemini" (no hardcoded defaults permitted)
# Supported models: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro, gemini-1.5-flash, gemini-1.5-flash-8b
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI: OPENAI_MODEL is required if LLM_PROVIDER="openai" (no hardcoded defaults permitted)
# Supported models: gpt-4o, gpt-4o-mini, o1, o1-mini, o3-mini, gpt-4-turbo
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic: ANTHROPIC_MODEL is required if LLM_PROVIDER="anthropic" (no hardcoded defaults permitted)
# Supported models: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# Concurrency of parallel PR review jobs in the BullMQ worker
WORKER_CONCURRENCY=5

# Worker Health & Metrics Server (Item 25)
WORKER_HEALTH_PORT=3001
WORKER_HEALTH_HOST="127.0.0.1"
WORKER_METRICS_TOKEN=""
